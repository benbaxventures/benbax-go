NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1

DATABASE_URL=postgresql://user:password@host:5432/db

# Password for the admin account created by `npm run db:seed`. Set this before
# seeding a real environment; never commit the real value.
SEED_ADMIN_PASSWORD=change-me-before-seeding

JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:19006

GOOGLE_MAPS_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=sk_test_your_test_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key_here
PAYSTACK_CALLBACK_URL=benbax://payment/callback

MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# --- Notifications ----------------------------------------------------------
# Every channel below is optional. Unset = that channel silently no-ops, so the
# API runs on the free channels (in-app feed + Expo push) with zero config.

# Expo push (free). Optional token for authenticated sends (recommended in prod).
EXPO_ACCESS_TOKEN=

# Email via Resend (free tier: 3k/month). EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=Benbax <noreply@yourdomain.com>

# WhatsApp via Meta WhatsApp Cloud API (free tier: 1k conversations/month).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS gateway (no free tier — stays off until set). Pick one: none | hubtel | twilio
SMS_PROVIDER=none
# Hubtel (Ghana — cheapest local SMS):
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
# Twilio (global):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# Extra channels when broadcasting a new request to the WHOLE fleet. Empty =
# free channels only (recommended). Set e.g. "whatsapp,sms" to also blast the
# fleet — costly and spammy at scale, so leave empty unless you mean it.
NOTIFY_FLEET_BROADCAST_CHANNELS=
