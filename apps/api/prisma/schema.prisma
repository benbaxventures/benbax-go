generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RIDER
  DRIVER
  ADMIN
  SUPPORT
  OPERATIONS
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum RiderStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  OFFLINE
  ON_DELIVERY
}

enum DriverStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  OFFLINE
  ON_TRIP
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DeliveryCategory {
  FOOD
  PARCEL
  COURIER
  GROCERY
  PHARMACY
  TRANSPORT_READY
}

enum DeliveryStatus {
  DRAFT
  REQUESTED
  ASSIGNING
  ASSIGNED
  PICKING_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
  FAILED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
}

enum RideTripStatus {
  REQUESTED
  ASSIGNING
  ASSIGNED
  DRIVER_ARRIVING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum RideAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
}

enum PaymentMethod {
  MTN_MOMO
  PAYSTACK_CARD
  WALLET
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum SupportStatus {
  OPEN
  TRIAGED
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

model User {
  id            String             @id @default(cuid())
  role          UserRole           @default(CUSTOMER)
  status        UserStatus         @default(ACTIVE)
  name          String
  email         String?            @unique
  phone         String             @unique
  passwordHash  String?
  avatarUrl     String?
  lastSeenAt    DateTime?
  riderProfile  RiderProfile?
  driverProfile DriverProfile?
  wallet        Wallet?
  savedPlaces   SavedLocation[]
  deliveries    Delivery[]         @relation("CustomerDeliveries")
  rideTrips      RideTrip[]         @relation("PassengerRideTrips")
  ratingsGiven  Rating[]           @relation("RatingsGiven")
  rideRatingsGiven RideRating[]     @relation("RideRatingsGiven")
  messages      ChatMessage[]
  deviceTokens  DeviceToken[]
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  supportCases      SupportTicket[]    @relation("TicketRequester")
  auditLogs         AuditLog[]         @relation("AuditActor")
  notifications Notification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RiderProfile {
  id               String                  @id @default(cuid())
  userId           String                  @unique
  status           RiderStatus             @default(PENDING_KYC)
  kycStatus        KycStatus               @default(NOT_STARTED)
  rating           Decimal                 @default(5.0) @db.Decimal(3, 2)
  totalDeliveries  Int                     @default(0)
  currentLatitude  Decimal?                @db.Decimal(10, 7)
  currentLongitude Decimal?                @db.Decimal(10, 7)
  lastLocationAt   DateTime?
  isOnline         Boolean                 @default(false)
  faceTemplateHash String?
  emergencyPhone   String?
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?
  kycDocuments     KycDocument[]
  assignments      DeliveryAssignment[]
  trackingPoints   DeliveryTrackingPoint[]
  suspiciousEvents SuspiciousActivity[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model Vehicle {
  id             String       @id @default(cuid())
  riderProfileId String      @unique
  type           String
  plateNumber    String?
  color          String?
  make           String?
  model          String?
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
}

model DriverProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  status           DriverStatus         @default(PENDING_KYC)
  kycStatus        KycStatus            @default(NOT_STARTED)
  rating           Decimal              @default(5.0) @db.Decimal(3, 2)
  totalTrips       Int                  @default(0)
  currentLatitude  Decimal?             @db.Decimal(10, 7)
  currentLongitude Decimal?             @db.Decimal(10, 7)
  lastLocationAt   DateTime?
  isOnline         Boolean              @default(false)
  faceTemplateHash String?
  emergencyPhone   String?
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          DriverVehicle?
  kycDocuments     DriverKycDocument[]
  assignments      RideAssignment[]
  trackingPoints   RideTrackingPoint[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model DriverVehicle {
  id              String        @id @default(cuid())
  driverProfileId String        @unique
  type            String
  plateNumber     String?
  color           String?
  make            String?
  model           String?
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
}

model DriverKycDocument {
  id              String        @id @default(cuid())
  driverProfileId String
  type            String
  fileUrl         String
  status          KycStatus     @default(SUBMITTED)
  reviewedAt      DateTime?
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model KycDocument {
  id             String       @id @default(cuid())
  riderProfileId String
  type           String
  fileUrl        String
  status         KycStatus    @default(SUBMITTED)
  reviewedAt     DateTime?
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Delivery {
  id                   String                  @id @default(cuid())
  trackingCode          String                  @unique
  customerId            String
  category              DeliveryCategory
  status                DeliveryStatus          @default(REQUESTED)
  pickupLabel           String
  pickupAddress         String?
  pickupLatitude        Decimal                 @db.Decimal(10, 7)
  pickupLongitude       Decimal                 @db.Decimal(10, 7)
  pickupLandmark        String?
  pickupVoiceNoteUrl    String?
  pickupWhatsappUrl     String?
  dropoffLabel          String
  dropoffAddress        String?
  dropoffLatitude       Decimal                 @db.Decimal(10, 7)
  dropoffLongitude      Decimal                 @db.Decimal(10, 7)
  dropoffLandmark       String?
  dropoffVoiceNoteUrl   String?
  dropoffWhatsappUrl    String?
  recipientName         String?
  recipientPhone        String?
  scheduledFor          DateTime?
  distanceKm            Decimal                 @db.Decimal(8, 2)
  etaMinutes            Int
  baseFare              Decimal                 @db.Decimal(10, 2)
  serviceFee            Decimal                 @db.Decimal(10, 2)
  surgeMultiplier       Decimal                 @default(1.0) @db.Decimal(4, 2)
  totalFare             Decimal                 @db.Decimal(10, 2)
  notes                 String?
  metadata              Json?
  customer              User                    @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Restrict)
  stops                 DeliveryStop[]
  assignments           DeliveryAssignment[]
  trackingPoints        DeliveryTrackingPoint[]
  payment               Payment?
  proof                 DeliveryProof?
  rating                Rating?
  chatThread            ChatThread?
  emergencyIncidents    EmergencyIncident[]
  supportTickets        SupportTicket[]
  suspiciousEvents      SuspiciousActivity[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
  @@index([pickupLatitude, pickupLongitude])
}

model RideTrip {
  id                   String                 @id @default(cuid())
  tripCode             String                 @unique
  passengerId          String
  status               RideTripStatus         @default(REQUESTED)
  pickupLabel          String
  pickupAddress        String?
  pickupLatitude       Decimal                @db.Decimal(10, 7)
  pickupLongitude      Decimal                @db.Decimal(10, 7)
  pickupLandmark       String?
  dropoffLabel         String
  dropoffAddress       String?
  dropoffLatitude      Decimal                @db.Decimal(10, 7)
  dropoffLongitude     Decimal                @db.Decimal(10, 7)
  dropoffLandmark      String?
  requestedVehicleType String?
  scheduledFor         DateTime?
  distanceKm           Decimal                @db.Decimal(8, 2)
  etaMinutes           Int
  baseFare             Decimal                @db.Decimal(10, 2)
  perKmFare            Decimal                @db.Decimal(10, 2)
  perMinuteFare        Decimal                @db.Decimal(10, 2)
  surgeMultiplier      Decimal                @default(1.0) @db.Decimal(4, 2)
  totalFare            Decimal                @db.Decimal(10, 2)
  notes                String?
  metadata             Json?
  passenger            User                   @relation("PassengerRideTrips", fields: [passengerId], references: [id], onDelete: Restrict)
  assignments          RideAssignment[]
  trackingPoints       RideTrackingPoint[]
  payment              RidePayment?
  rating               RideRating?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([passengerId, createdAt])
  @@index([status])
  @@index([pickupLatitude, pickupLongitude])
}

model RideAssignment {
  id              String               @id @default(cuid())
  tripId          String
  driverProfileId String
  status          RideAssignmentStatus @default(OFFERED)
  score           Decimal              @db.Decimal(6, 2)
  offeredAt       DateTime             @default(now())
  respondedAt     DateTime?
  expiresAt       DateTime
  trip            RideTrip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile        @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([driverProfileId, status])
}

model RideTrackingPoint {
  id              String        @id @default(cuid())
  tripId          String
  driverProfileId String
  latitude        Decimal       @db.Decimal(10, 7)
  longitude       Decimal       @db.Decimal(10, 7)
  heading         Decimal?      @db.Decimal(6, 2)
  speedKph        Decimal?      @db.Decimal(6, 2)
  batteryLevel    Int?
  source          String        @default("GPS")
  capturedAt      DateTime      @default(now())
  trip            RideTrip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([tripId, capturedAt])
}

model RidePayment {
  id           String        @id @default(cuid())
  tripId       String        @unique
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("GHS")
  provider     String?
  providerRef  String?
  mobileNumber String?
  metadata     Json?
  trip         RideTrip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model RideRating {
  id         String   @id @default(cuid())
  tripId     String   @unique
  authorId   String
  targetType String
  score      Int
  comment    String?
  trip       RideTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author     User     @relation("RideRatingsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model DeliveryStop {
  id          String   @id @default(cuid())
  deliveryId  String
  sequence    Int
  label       String
  address     String?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  landmark    String?
  contactName String?
  contactPhone String?
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryAssignment {
  id             String           @id @default(cuid())
  deliveryId     String
  riderProfileId String
  status         AssignmentStatus @default(OFFERED)
  score          Decimal          @db.Decimal(6, 2)
  offeredAt      DateTime         @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime
  delivery       Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  riderProfile   RiderProfile     @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@index([deliveryId, status])
  @@index([riderProfileId, status])
}

model DeliveryTrackingPoint {
  id             String       @id @default(cuid())
  deliveryId     String
  riderProfileId String
  latitude       Decimal      @db.Decimal(10, 7)
  longitude      Decimal      @db.Decimal(10, 7)
  heading        Decimal?     @db.Decimal(6, 2)
  speedKph       Decimal?     @db.Decimal(6, 2)
  batteryLevel   Int?
  source         String       @default("GPS")
  capturedAt     DateTime     @default(now())
  delivery       Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@index([deliveryId, capturedAt])
}

model Payment {
  id            String        @id @default(cuid())
  deliveryId    String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("GHS")
  provider      String?
  providerRef   String?
  mobileNumber  String?
  metadata      Json?
  delivery      Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DeliveryProof {
  id             String   @id @default(cuid())
  deliveryId     String   @unique
  otpCodeHash    String?
  photoUrl       String?
  signatureUrl   String?
  recipientName  String?
  recipientPhone String?
  notes          String?
  verifiedAt     DateTime?
  delivery       Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  currency     String              @default("GHS")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  reference String?
  metadata  Json?
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SavedLocation {
  id                  String   @id @default(cuid())
  userId              String
  label               String
  address             String?
  latitude            Decimal  @db.Decimal(10, 7)
  longitude           Decimal  @db.Decimal(10, 7)
  landmark            String?
  voiceNoteUrl        String?
  whatsappLocationUrl String?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
}

model Rating {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  authorId   String
  targetType String
  score      Int
  comment    String?
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  author     User     @relation("RatingsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ChatThread {
  id         String        @id @default(cuid())
  deliveryId String        @unique
  delivery   Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  mediaUrl  String?
  readAt    DateTime?
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String
  discountValue   Decimal  @db.Decimal(10, 2)
  maxRedemptions  Int?
  redeemedCount   Int      @default(0)
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Geofence {
  id             String   @id @default(cuid())
  name           String
  city           String
  polygon        Json
  isActive       Boolean  @default(true)
  baseMultiplier Decimal  @default(1.0) @db.Decimal(4, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingRule {
  id             String   @id @default(cuid())
  name           String
  category       DeliveryCategory?
  baseFare       Decimal  @db.Decimal(10, 2)
  perKm          Decimal  @db.Decimal(10, 2)
  perMinute      Decimal  @db.Decimal(10, 2)
  serviceFee     Decimal  @db.Decimal(10, 2)
  surgeMultiplier Decimal @default(1.0) @db.Decimal(4, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model EmergencyIncident {
  id         String    @id @default(cuid())
  deliveryId String?
  reporterId String
  status     String    @default("OPEN")
  latitude   Decimal?  @db.Decimal(10, 7)
  longitude  Decimal?  @db.Decimal(10, 7)
  details    String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model SupportTicket {
  id          String        @id @default(cuid())
  requesterId String
  deliveryId  String?
  status      SupportStatus @default(OPEN)
  priority    String        @default("NORMAL")
  subject     String
  description String
  delivery    Delivery?     @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  requester   User          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model SuspiciousActivity {
  id             String        @id @default(cuid())
  riderProfileId String?
  deliveryId     String?
  type           String
  severity       String
  details        Json?
  riderProfile   RiderProfile? @relation(fields: [riderProfileId], references: [id], onDelete: SetNull)
  delivery       Delivery?     @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}
