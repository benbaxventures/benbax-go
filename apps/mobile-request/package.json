{
  "name": "@benbax/mobile-request",
  "private": true,
  "version": "0.1.0",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "start:phone": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-phone.ps1",
    "start:tunnel": "expo start --tunnel -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:build:dev": "eas build --profile development --platform android",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:production": "eas build --profile production --platform android",
    "eas:update:preview": "eas update --channel preview --platform android",
    "eas:update:production": "eas update --channel production --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@tanstack/react-query": "^5.74.4",
    "expo": "~55.0.25",
    "expo-auth-session": "~55.0.16",
    "expo-constants": "~55.0.16",
    "expo-local-authentication": "~55.0.14",
    "expo-location": "~55.1.9",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "firebase": "^12.13.0",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4.1.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0",
