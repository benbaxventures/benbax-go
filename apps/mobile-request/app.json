{
  "expo": {
    "name": "Benbax Request",
    "slug": "benbax-request",
    "scheme": "benbax",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/benbax-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/benbax-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C66"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benbax.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Benbax uses your location to set pickup points and track deliveries."
      }
    },
    "android": {
      "package": "com.benbax.customer",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66",
        "foregroundImage": "./assets/benbax-logo.png"
      }
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-updates",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/benbax-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E7C66"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}",
      "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
      "eas": {
        "projectId": "ad6d334c-8419-46f9-9f81-17aeb7d34655"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ad6d334c-8419-46f9-9f81-17aeb7d34655",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "0.1.0"
  }
}
