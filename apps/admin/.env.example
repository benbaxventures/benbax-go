# The dashboard calls the API at a relative /api/v1 by default: Vercel rewrites
# that path in production (vercel.json) and the Vite dev server proxies it
# (vite.config.ts). Leave these unset unless you are pointing the dashboard
# somewhere other than the deployed API.

# Where `npm run dev` proxies /api to. Defaults to the deployed API, so the
# dashboard works with nothing running locally. Set this to develop against a
# local API instead.
# VITE_DEV_API_PROXY=http://localhost:4000

# API origin used for the Socket.IO connection (rewrites can't carry a
# WebSocket upgrade, so this one has to be absolute).
# VITE_API_ORIGIN=http://localhost:4000

# Full override of the REST base URL. Only needed to bypass the proxy entirely.
# VITE_API_BASE_URL=http://localhost:4000/api/v1
# VITE_SOCKET_URL=http://localhost:4000
