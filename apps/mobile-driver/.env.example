# Production/preview default for real phones.
EXPO_PUBLIC_API_BASE_URL=https://benbaxapi-production.up.railway.app/api/v1
EXPO_PUBLIC_SOCKET_URL=https://benbaxapi-production.up.railway.app
EXPO_PUBLIC_DRIVER_EAS_PROJECT_ID=81c6b202-f147-4843-a15a-59c386d82b42

# Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Set true only when intentionally testing a local backend from Expo/dev builds.
EXPO_PUBLIC_USE_LOCAL_API=false
