{
  "name": "@benbax/mobile-driver",
  "private": true,
  "version": "0.1.0",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "start:phone": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-phone.ps1",
    "start:tunnel": "expo start --tunnel -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:build:dev": "eas build --profile development --platform android",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:production": "eas build --profile production --platform android",
    "eas:update:preview": "eas update --channel preview --platform android",
    "eas:update:production": "eas update --channel production --platform android"
  },
  "dependencies": {
    "@benbax/shared": "file:../../packages/shared",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.74.4",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.511.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.4"
