{
  "expo": {
    "name": "Benbax Driver",
    "slug": "benbax-driver",
    "scheme": "benbax-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C66"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benbax.driver",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Benbax uses driver location for ride dispatch, routing, safety, and live tracking.",
        "NSCameraUsageDescription": "Benbax uses the camera to capture driver KYC documents.",
        "NSPhotoLibraryUsageDescription": "Benbax uses photo library access to upload driver KYC documents."
      }
    },
    "android": {
      "package": "com.benbax.driver",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "plugins": [
      "expo-location",
      "expo-document-picker",
      "@react-native-google-signin/google-signin",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "Benbax uses photo library access to upload driver KYC documents.",
          "cameraPermission": "Benbax uses the camera to capture driver KYC documents."
        }
      ],
      "expo-web-browser",
      "expo-splash-screen",
      "expo-notifications",
      "@sentry/react-native/expo"
    ],
    "extra": {
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}",
      "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
      "eas": {
        "projectId": "12d0a70a-1626-4e4c-b900-8d844978d653"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/12d0a70a-1626-4e4c-b900-8d844978d653",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "0.1.0"
  }
}
